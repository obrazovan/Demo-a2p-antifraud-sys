# ============================================================================
# Demo A2P Anti-Fraud System - Environment Variables Template
# Copy to `.env` for local overrides (never commit `.env`)
# ============================================================================

# --- PostgreSQL (Rules DB) ---
POSTGRES_RULES_DB=rules_db
POSTGRES_RULES_USER=postgres
POSTGRES_RULES_PASSWORD=postgrespassword
POSTGRES_RULES_PORT=5432

# --- PostgreSQL (Reputation DB) ---
POSTGRES_REPUTATION_DB=reputation_db
POSTGRES_REPUTATION_USER=postgres
POSTGRES_REPUTATION_PASSWORD=postgrespassword
POSTGRES_REPUTATION_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672

# --- ClickHouse ---
CLICKHOUSE_DB=analytics_db
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhousepassword
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Rule Engine Service ---
RULE_ENGINE_PORT=8001
RULE_ENGINE_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/rules_db

# --- Reputation Service ---
REPUTATION_SERVICE_PORT=8002
REPUTATION_LOG_LEVEL=INFO
REPUTATION_DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5433/reputation_db

# --- Velocity Service ---
VELOCITY_SERVICE_PORT=8003
VELOCITY_LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0

# --- Scoring Service ---
SCORING_SERVICE_PORT=8004
SCORING_LOG_LEVEL=INFO
RULE_ENGINE_URL=http://localhost:8001
REPUTATION_URL=http://localhost:8002
VELOCITY_URL=http://localhost:8003
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=antifraud.events
RABBITMQ_ROUTING_KEY=inspection.completed
DENY_THRESHOLD=60.0

# --- Analytics Service ---
ANALYTICS_SERVICE_PORT=8005
ANALYTICS_LOG_LEVEL=INFO
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
RABBITMQ_QUEUE=analytics.raw_events
BATCH_SIZE=50
FLUSH_INTERVAL_SECONDS=2.0

# --- Alerting Service ---
ALERTING_SERVICE_PORT=8006
ALERTING_LOG_LEVEL=INFO
SQLITE_DB_PATH=./alerts_audit.db
ALERTING_RABBITMQ_QUEUE=security.alerts
CRITICAL_RISK_THRESHOLD=80.0
