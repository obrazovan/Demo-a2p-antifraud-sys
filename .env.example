# ============================================================================
# Demo A2P Anti-Fraud System - Environment Variables Template
# Copy to `.env` for local overrides (never commit `.env`)
# ============================================================================

# --- PostgreSQL (Rules DB) ---
POSTGRES_RULES_DB=rules_db
POSTGRES_RULES_USER=postgres
POSTGRES_RULES_PASSWORD=postgrespassword
POSTGRES_RULES_PORT=5432

# --- PostgreSQL (Reputation DB) ---
POSTGRES_REPUTATION_DB=reputation_db
POSTGRES_REPUTATION_USER=postgres
POSTGRES_REPUTATION_PASSWORD=postgrespassword
POSTGRES_REPUTATION_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672

# --- ClickHouse ---
CLICKHOUSE_DB=analytics_db
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhousepassword
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Rule Engine Service ---
RULE_ENGINE_PORT=8001
RULE_ENGINE_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/rules_db

# --- Reputation Service ---
REPUTATION_SERVICE_PORT=8002
REPUTATION_LOG_LEVEL=INFO
REPUTATION_DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5433/reputation_db

# --- Velocity Service ---
VELOCITY_SERVICE_PORT=8003
VELOCITY_LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0
