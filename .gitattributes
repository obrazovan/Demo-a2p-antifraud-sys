# Normalize line endings across Windows/Linux/macOS for Docker compatibility
* text=auto eol=lf

*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ini text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf
